
<?xml version="1.0" encoding="utf-8"?>
<dialog width="500" height="600" title="Help">
	<tabview width="100%" height="100%">
		<box width="100%" text="Basics">
			<label text="No one's around to help." />
		</box>
		<box width="100%" text="Hotkeys">
			<tableview width="100%" height="510" contentWidth="100%">
				<header width="100%">
					<column id="action" text="Action" width="50%" />
					<column id="keybind" text="Keybind" width="50%" />
				</header>
				<data>
					<item action="Show User Guide" keybind="F1" />
					<item action="Place Note/Event" keybind="Left Click on Grid" />
					<item action="Place Hold Note" keybind="Left Click and Drag on Grid" />
					<item action="Select Note/Event" keybind="Left Click" />
					<item action="Add Note/Event to Selection" keybind="Ctrl + Left Click" />
					<item action="Select Box" keybind="Shift + Left Click and Drag" />
					<item action="Remove Note/Event" keybind="Right Click on Note" />
					<item action="Show Note Options" keybind="Shift + Right Click on Note" />
					<item action="Clear Note Kind from Cursor" keybind="Right Click on Empty Grid" />
					<item action="Open Note in Notes Panel" keybind="Double Click on Note" />
					<item action="Open Event in Events Panel" keybind="Double Click on Event" />
					<item action="Select BPM/Time Signature Change" keybind="Left Click on Tag" />
					<item action="Open Time Change in Timing Panel" keybind="Left Click on Selected Tag" />
					<item action="Add Tag/Comment/Sub-Beat to Selection" keybind="Ctrl + Left Click" />
					<item action="Move Time Change/Comment/Sub-Beat" keybind="Left Click and Drag on Tag or Header" />
					<item action="Select Time Changes/Comments/Sub-Beats" keybind="Select Box Reaching Their Tags or Panels" />
					<item action="Open/Close Comment" keybind="Left Click on Comment Header" />
					<item action="Add/Remove Sub-Beat at Mouse" keybind="B" />
					<item action="Select Region (Start/End)" keybind="Tab" />
					<item action="Place/Remove Opponent Note at Playhead" keybind="1/2/3/4 (Live Input: Number Keys)" />
					<item action="Place/Remove Player Note at Playhead" keybind="5/6/7/8 (Live Input: Number Keys)" />
					<item action="Place Hold Note at Playhead" keybind="Hold 1-8 While Playing" />
					<item action="Remove Note at Playhead Only" keybind="Shift + 1-8" />
					<item action="Place Focus Camera - Player Event at Playhead" keybind="Dot (.)"/>
					<item action="Place Focus Camera - Opponent Event at Playhead" keybind="Comma (,)"/>
					<item action="Scroll Up/Down" keybind="Mouse Wheel" />
					<item action="Scroll Up/Down (Fast)" keybind="Shift + Mouse Wheel" />
					<item action="Zoom In/Out" keybind="Ctrl + Mouse Wheel" />
					<item action="Scroll Up" keybind="Up Arrow/W" />
					<item action="Scroll Up (Fast)" keybind="Shift + Up Arrow/W" />
					<item action="Scroll Up (Precise)" keybind="Ctrl + Up Arrow" />
					<item action="Scroll Down" keybind="Down Arrow/S" />
					<item action="Scroll Down (Fast)" keybind="Shift + Down Arrow/S" />
					<item action="Scroll Down (Precise)" keybind="Ctrl + Down Arrow" />
					<item action="Scroll, Leave Playhead Stationary" keybind="Middle Click + Arrows/Mouse Wheel" />
					<item action="Scroll (Playhead Only)" keybind="Alt + Arrows/Mouse Wheel" />
					<item action="Open Command Palette" keybind="Ctrl + P" />
					<item action="Open Command Palette (Show and Run Commands)" keybind="Ctrl + Shift + P" />
					<item action="Open Command Palette (Go to Measure)" keybind="Ctrl + G" />
					<item action="Open Command Palette (Search for Comment)" keybind="Ctrl + B" />
					<item action="Open Command Palette (Open Toolbox)" keybind="Ctrl + W" />
					<item action="Place New Comment at Playhead" keybind="Alt + B" />
					<item action="Jump to Start" keybind="Home" />
					<item action="Jump Back" keybind="Page Up" />
					<item action="Jump Forward" keybind="Page Down" />
					<item action="Jump to End" keybind="End" />
					<item action="Play/Pause" keybind="Space" />
					<item action="Increase Note Snap" keybind="Right Arrow / ]" />
					<item action="Decrease Note Snap" keybind="Left Arrow / [" />
					<item action="Increase Playback Speed (0.1x)" keybind="Shift + Right Arrow" />
					<item action="Decrease Playback Speed (0.1x)" keybind="Shift + Left Arrow" />
					<item action="New Chart" keybind="Ctrl + N" />
					<item action="Open Chart" keybind="Ctrl + O" />
					<item action="Save Chart" keybind="Ctrl + S" />
					<item action="Save Chart As..." keybind="Ctrl + Shift + S" />
					<item action="Quit to Menu" keybind="Ctrl + Q" />
					<item action="Undo (Works in Panels Too)" keybind="Ctrl + Z" />
					<item action="Redo (Works in Panels Too)" keybind="Ctrl + Y" />
					<item action="Copy Selection" keybind="Ctrl + C" />
					<item action="Cut Selection" keybind="Ctrl + X" />
					<item action="Paste (Last Copied Kind of Item)" keybind="Ctrl + V" />
					<item action="Paste Unsnapped" keybind="Ctrl + Shift + V" />
					<item action="Delete Selection" keybind="Delete" />
					<item action="Copy/Paste/Delete in a Picked List (Timing, Difficulty, Events Chain, Comments, Sub-Beats)" keybind="Ctrl + C / Ctrl + V / Delete" />
					<item action="Delete Stacked Notes" keybind="Shift + Delete" />
					<item action="Flip Selected Notes" keybind="Ctrl + F" />
					<item action="Mirror Notes Along X Axis" keybind="Ctrl + Shift + M" />
					<item action="Mirror Notes Along Y Axis" keybind="Ctrl + Alt + M" />
					<item action="Mirror Notes Along Both Axes" keybind="Ctrl + Shift + Alt + M" />
					<item action="Select All Notes" keybind="Ctrl + A" />
					<item action="Select All Events" keybind="Ctrl + Alt + A" />
					<item action="Append All Notes to Selection" keybind="Ctrl + Shift + A" />
					<item action="Append All Events to Selection" keybind="Ctrl + Alt + Shift + A" />
					<item action="Select All Notes Before Playhead" keybind="Shift + Home" />
					<item action="Deselect All Notes Before Playhead" keybind="Ctrl + Shift + Home" />
					<item action="Select All Notes After Playhead" keybind="Shift + End" />
					<item action="Deselect All Notes After Playhead" keybind="Ctrl + Shift + End" />
					<item action="Select None" keybind="Ctrl + D" />
					<item action="Select Inverse" keybind="Ctrl + I" />
					<item action="Mute/Unmute Metronome" keybind="Shift + M" />
					<item action="Mute/Unmute Hitsounds" keybind="Shift + H" />
					<item action="Mute/Unmute Instrumental" keybind="Shift + I" />
					<item action="Mute/Unmute Both Vocals" keybind="Shift + V" />
					<item action="Mute/Unmute Player Vocals" keybind="Shift + B" />
					<item action="Mute/Unmute Opponent Vocals" keybind="Shift + D" />
					<item action="Test Song" keybind="Enter" />
					<item action="Test Song (Minimal Mode)" keybind="Shift + Enter" />
					<item action="Switch to Easier Difficulty" keybind="Ctrl + Left Arrow" />
					<item action="Switch to Harder Difficulty" keybind="Ctrl + Right Arrow" />
				</data>
			</tableview>
		</box>
		<box width="100%" text="Even More Details" />
	</tabview>
</dialog>
