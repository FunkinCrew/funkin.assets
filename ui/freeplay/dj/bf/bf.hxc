import funkin.audio.FunkinSound;
import funkin.ui.freeplay.dj.AnimateAtlasFreeplayDJ;
import funkin.ui.freeplay.dj.FreeplayDJAnimation;
import funkin.ui.freeplay.dj.FreeplayDJState;

using StringTools;

class BoyfriendFreeplayDJ extends AnimateAtlasFreeplayDJ
{
  /**
   * The amount of time (in seconds) that must pass before the cartoon animation can be played.
   */
  public static final IDLE_CARTOON_PERIOD:Float = 120.0;

  /**
   * The list of available cartoons.
   * This is loaded from `assets/ui/freeplay/dj/bf/cartoons/`!!
   */
  public final CARTOON_LIST:Array<String> = Assets.list().filter((path) -> return path.startsWith('assets/ui/freeplay/dj/bf/cartoons/'));

  /**
   * The name of the symbol that contains the cartoon animation.
   * This shouldn't change if the texture atlas is re-exported, but change it here if it does!
   */
  public final CARTOON_SYMBOL:String = 'Boyfriend DJ watchin tv OG';

  /**
   * The defined name of the cartoon animation.
   */
  public final CARTOON_ANIMATION_NAME:String = 'cartoon';

  var playingCartoon:Bool = false;
  var currentCartoonFrame:Int = 60;
  var _cartoonSound:Null<FunkinSound> = null;

  public function new(x:Float, y:Float, characterId:String)
  {
    super(x, y, characterId);
    this._cartoonSound?.destroy();

    animation.onFrameChange.add((name, number) ->
    {
      if (name == CARTOON_ANIMATION_NAME)
      {
        if (number == getCartoonFrame('REMOTE_CLICK')) FunkinSound.playOnce(Paths.sound('ui/freeplay/dj/bf/remote-click'));
        if (number == getCartoonFrame('TV_SOUND')) _runTVLogic();
      }
    });
  }

  override function update(elapsed:Float):Void
  {
    super.update(elapsed);

    if (currentState == FreeplayDJState.Custom)
    {
      if (getCurrentAnimation() != CARTOON_ANIMATION_NAME)
      {
        playAnimation(CARTOON_ANIMATION_NAME, true);
      }

      timeIdling = 0;
    }
  }

  override function onAnimationFinished(name:String):Void
  {
    super.onAnimationFinished(name);

    if (name == FreeplayDJAnimation.IDLE)
    {
      if (timeIdling >= IDLE_CARTOON_PERIOD && seenIdleEasterEgg)
      {
        currentState = FreeplayDJState.Custom;
      }
    }

    if (name == CARTOON_ANIMATION_NAME)
    {
      this.currentCartoonFrame = FlxG.random.bool(33) ? getCartoonFrame('BLINK') : getCartoonFrame('LOOP');

      // Character switches channels when the video ends, or at a 10% chance each time his idle loops.
      if (FlxG.random.bool(10))
      {
        this.currentCartoonFrame = getCartoonFrame('CHANGE_CHANNEL');
      }

      playAnimation(CARTOON_ANIMATION_NAME, true, false, false, this.currentCartoonFrame);
    }
  }

  function _runTVLogic():Void
  {
    var soundPath:String = (_cartoonSound == null) ? 'ui/freeplay/dj/bf/tv-on' : 'ui/freeplay/dj/bf/channel-switch';

    FunkinSound.playOnce(Paths.sound(soundPath), 1.0, () ->
    {
      loadCartoon();
    });
  }

  public function getCartoonFrame(frameLabel:String):Int
  {
    var cartoonSymbol:Null<SymbolItem> = this.library.getSymbol(CARTOON_SYMBOL);
    var cartoonFrame:Null<Frame> = this.getFrameLabel(frameLabel, cartoonSymbol.timeline);

    return cartoonFrame.index;
  }

  public function loadCartoon():Void
  {
    playingCartoon = true;

    if (_cartoonSound != null)
    {
      _cartoonSound.stop();
      _cartoonSound = null;
    }

    var randomCartoon:String = CARTOON_LIST[
      FlxG.random.int(0, CARTOON_LIST.length - 1)
    ];

    _cartoonSound = FunkinSound.load(randomCartoon, 1.0, false, true, true, false, () ->
    {
      playAnimation(CARTOON_ANIMATION_NAME, true, false, false, getCartoonFrame('CHANGE_CHANNEL'));
    });

    // Fade out music to 40% volume over 1 second.
    // This helps make the TV a bit more audible.
    FlxG.sound.music.fadeOut(1.0, 0.1);

    // Play the cartoon at a random time between the start and 5 seconds from the end.
    if (_cartoonSound != null) _cartoonSound.time = FlxG.random.float(0, Math.max(_cartoonSound.length - (5 * Constants.MS_PER_SEC), 0.0));
  }

  public override function getMusicPreviewMult():Float
  {
    return playingCartoon ? 0.15 : 1;
  }

  public override function onConfirm():Void
  {
    super.onConfirm();

    if (this._cartoonSound != null) this._cartoonSound.fadeOut(.25, 0);
  }

  public override function toCharSelect():Void
  {
    super.toCharSelect();

    if (this._cartoonSound != null) this._cartoonSound.fadeOut(.25, 0);
  }

  public override function destroy():Void
  {
    super.destroy();

    if (this._cartoonSound != null)
    {
      this._cartoonSound.stop();
      this._cartoonSound.destroy();
      this._cartoonSound = null;
    }
  }
}
