<?xml version="1.0" encoding="utf-8"?>
<dialog width="800" height="500" title="Camera Editor - Welcome">
	<!-- Body -->
	<hbox width="100%" height="100%">
		<card id="splashSectionLeft" width="33%" height="100%" text="Upload Chart">
			<box width="100%" id="chartBox" height="100%" styleName="upload-bg" style="border: 2px dotted #DDDDDD; padding: 5px;">
				<label width="100%" style="font-size: 24px" verticalAlign="center" horizontalAlign="center" textAlign="center" text="Drag and drop a chart file (.fnfc) here, or click to browse." />
			</box>
		</card>
		<card id="splashSectionMiddle" width="33%" height="100%" text="Open Recent">
			<scrollview width="100%" height="50%" contentWidth="100%">
				<vbox width="100%" id="splashRecentContainer" />
			</scrollview>
		</card>
		<card id="splashSectionRight" width="34%" height="100%" text="Create From Song">
			<SongTemplateList id="splashTemplateList" width="100%" height="100%" />
		</card>
	</hbox>
</dialog>
