<?xml version="1.0" encoding="utf-8"?>
<dialog width="300" title="Set Default Focus/Zoom">
  <vbox width="100%">
    <hbox width="100%">
      <label text="Def. Zoom Level" verticalAlign="center" horizontalAlign="right" width="100%" />
      <number-stepper id="defaultCameraZoom" width="80" min="0.1" max="10" step="0.1" precision="2" />
      <label text="x" verticalAlign="center" />
    </hbox>
    <hbox width="100%">
      <label text="Def. Camera Focus" verticalAlign="center" horizontalAlign="right" width="100%" />
      <dropdown id="defaultCameraFocus" width="160">
        <data>
          <item id="0" text="Player" />
          <item id="1" text="Opponent" />
          <item id="2" text="Girlfriend" />
        </data>
      </dropdown>
    </hbox>
    <hbox width="100%">
      <label text="Keep zoom after countdown" verticalAlign="center" horizontalAlign="right" width="100%" />
      <checkbox id="forceCameraZoom" />
    </hbox>
    <hbox width="100%" horizontalAlign="right">
      <button text="Cancel" id="dialogCancel" />
      <spacer width="100%" />
      <button text="Apply" id="dialogApply" />
    </hbox>
  </vbox>
</dialog>
