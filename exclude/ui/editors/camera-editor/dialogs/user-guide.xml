<?xml version="1.0" encoding="utf-8"?>
<dialog width="500" height="600" title="Help">
	<tabview width="100%" height="100%">
		<box width="100%" text="Basics">
			<label text="Welcome to the work-in-progress Camera Editor!\n\nInformation in this User Guide may be incomplete\nas development continues.\n\nControls are viewable in the Hotkeys tab." />
		</box>
		<box width="100%" text="Hotkeys">
			<tableview width="100%" height="510" contentWidth="100%">
				<header width="100%">
					<column id="action" text="Action" width="50%" />
					<column id="keybind" text="Keybind" width="50%" />
				</header>
				<data>
					<item action="Show User Guide" keybind="F1" />
					<item action="Pan Stage Preview" keybind="Alt and Drag/Middle Click and Drag" />
					<item action="Zoom In/Out Stage Preview" keybind="Mouse Wheel" />
					<item action="Zoom In/Out Timeline" keybind="Shift + Mouse Wheel" />
					<item action="Scroll Timeline Up/Down" keybind="Ctrl + Mouse Wheel"/>
					<item action="Temporarily Toggle Timeline Event Snapping" keybind="Shift" />
					<item action="Timeline Add Event Menu" keybind="Shift + A/Right Click" />
					<item action="Add Focus Camera Event (Opponent)" keybind=","/>
					<item action="Add Focus Camera Event (Player)" keybind="."/>
					<item action="Play/Pause" keybind="Space" />
					<item action="Jump to Start" keybind="Home" />
					<item action="Scrub Position in Timeline" keybind="Left Click and Drag" />
					<item action="Undo" keybind="Ctrl + Z" />
					<item action="Redo" keybind="Ctrl + Y" />
					<item action="Copy Selection" keybind="Ctrl + C" />
					<item action="Cut Selection" keybind="Ctrl + X" />
					<item action="Paste" keybind="Ctrl + V" />
					<item action="Delete Selection" keybind="Delete" />
					<item action="Select Event" keybind="Left Click" />
					<item action="Select Multiple Events" keybind="Left Click and Drag" />
					<item action="Select All Events" keybind="Ctrl + A" />
					<item action="Add/Remove Event from Selection" keybind="Ctrl + Left Click" />
					<item action="Open Chart" keybind="Ctrl + O" />
					<item action="Save Chart" keybind="Ctrl + S" />
					<item action="Save Chart As..." keybind="Ctrl + Shift + S" />
					<item action="Quit to Menu" keybind="Ctrl + Q" />
				</data>
			</tableview>
		</box>
		<box width="100%" text="Even More Details" />
	</tabview>
</dialog>
