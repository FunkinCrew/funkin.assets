<?xml version="1.0" encoding="utf-8"?>
<vbox width="100%" height="100%" id="propertiesContainer">
  <hbox width="100%">
    <label text="Zoom" verticalAlign="center" horizontalAlign="right" width="100%" />
    <number-stepper pos="1.0" step="0.1" width="160" min="0.1" id="zoomCameraZoomLevel" />
  </hbox>
  <hbox width="100%">
    <label text="Mode" verticalAlign="center" horizontalAlign="right" width="100%" />
    <dropdown text="Mode" width="160" id="zoomCameraMode">
      <data>
        <item value="-1" text="Position" />
        <item value="0" text="Player" />
        <item value="1" text="Opponent" />
        <item value="2" text="Girlfriend" />
      </data>
    </dropdown>
  </hbox>
  <hbox width="100%">
    <label text="Duration" verticalAlign="center" horizontalAlign="right" width="100%" />
    <number-stepper pos="1.25" step="0.1" min="0.1" max="10.0" width="160" id="zoomCameraDuration"/>
  </hbox>
  <frame text="Ease" collapsible="true" width="100%" height="180">
    <hbox width="100%" height="100%">
      <vbox width="100" height="100%">
        <dropdown text="Ease" id="zoomCameraEase" value="linear">
          <data>
            <item value="linear" text="Linear" />
            <item value="instant" text="Instant (Ignores duration)" />
            <item value="sine" text="Sine" />
            <item value="quad" text="Quad" />
            <item value="cube" text="Cube" />
            <item value="quart" text="Quart" />
            <item value="quint" text="Quint" />
            <item value="expo" text="Expo" />
            <item value="smoothStep" text="Smooth Step" />
            <item value="smootherStep" text="Smoother Step" />
            <item value="elastic" text="Elastic" />
            <item value="back" text="Back" />
            <item value="bounce" text="Bounce" />
            <item value="circ" text="Circ " />
          </data>
        </dropdown>
        <dropdown text="Ease Dir" id="zoomCameraEaseDir">
          <data>
            <item value="In" text="In" />
            <item value="In" text="Out" />
            <item value="In" text="In/Out" />
          </data>
        </dropdown>
      </vbox>
      <hbox width="100%" height="100%" id="zoomCameraEaseBox">
        <image width="100" height="100" style="border:1px solid $normal-border-color" id="zoomCameraEaseGraph" />
        <image width="16" height="100" style="border:1px solid $normal-border-color" id="zoomCameraEaseDot" />
      </hbox>
    </hbox>
  </frame>
</vbox>
