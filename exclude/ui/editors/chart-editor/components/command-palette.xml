<?xml version="1.0" encoding="utf-8"?>
<!--
	This component serves as a quick dialog box you can pull up and type in to perform actions.
-->
<panel id="commandPalette" width="45%" height="240" styleName="command-palette">
  <vbox width="100%" height="100%">

    <textfield id="commandPaletteInput" width="100%" height="32" styleName="command-palette-input" />

    <listview id="commandPaletteList" width="100%" height="192" styleName="command-palette-list">
      <item-renderer width="100%" allowHover="true">
        <hbox width="100%">
          <label id="title" horizontalAlign="left" styleName="command-palette-list-title"/>
          <label id="subtitle" horizontalAlign="left" styleName="command-palette-list-subtitle"/>
          <spacer width="100%" />
          <label id="shortcut" horizontalAlign="right" styleName="command-palette-list-subtitle"/>
        </hbox>
      </item-renderer>
      <data />
    </listview>
  </vbox>
</panel>
