<?xml version="1.0" encoding="utf-8"?>
<menubar id="menubar" width="100%" paddingLeft="256">
  <style>
    .menu {
    // The width of the individual menu items
    width: 160px;
    }
    #menubarOpenRecent {
      width: auto;
      initial-width: none;
      min-width: 160px;
      max-width: 800px;
    }
  </style>
  <menu text="File">
    <menu-item id="menubarItemNewChart" text="New Chart" shortcutText="Ctrl+N" />
    <menu-separator />
    <menu-item id="menubarItemOpenChart" text="Open Chart..." shortcutText="Ctrl+O" />
    <menu id="menubarOpenRecent" text="Open Recent" />
    <menu-separator />
    <menu-item id="menubarItemSaveChart" text="Save Chart" shortcutText="Ctrl+S" />
    <menu-item id="menubarItemSaveChartAs" text="Save Chart As..." shortcutText="Ctrl+Shift+S" />
    <menu text="Export Chart As...">
      <menu-item id="menubarItemExportChartAsFolder" text="Folder" />
    </menu>
    <menu-separator />
    <menu-item id="menubarItemPreferences" text="Preferences" />
    <menu-separator />
    <menu-item id="menubarItemExit" text="Exit" shortcutText="Ctrl+Q" />
  </menu>
  <menu text="Edit" width="280px;">
    <menu-item id="menubarItemUndo" text="Undo" shortcutText="Ctrl+Z" />
    <menu-item id="menubarItemRedo" text="Redo" shortcutText="Ctrl+Y" />
    <menu-separator />
    <menu-item id="menubarItemCut" text="Cut" shortcutText="Ctrl+X" />
    <menu-item id="menubarItemCopy" text="Copy" shortcutText="Ctrl+C" />
    <menu-item id="menubarItemPaste" text="Paste" shortcutText="Ctrl+V" />
    <menu-item id="menubarItemPasteUnsnapped" text="Paste (Unsnapped)" shortcutText="Ctrl+Shift+V" />
    <menu-item id="menubarItemDelete" text="Delete" shortcutText="Delete" />
    <menu-item id="menubarItemDeleteStacked" text="Delete Stacked Notes" shortcutText="Shift+Delete" />
    <menu-separator />
    <menu-item id="menubarItemFlipNotes" text="Flip Selected Notes" shortcutText="Ctrl+F" />
    <menu text="Mirror Notes">
        <menu-item id="menubarItemMirrorX" text="X Axis" shortcutText="Ctrl+Shift+M" />
        <menu-item id="menubarItemMirrorY" text="Y Axis" shortcutText="Ctrl+Alt+M" />
        <menu-item id="menubarItemMirrorXY" text="XY Axis" shortcutText="Ctrl+Shift+Alt+M" />
        <vbox width="100%">
          <menu-checkbox width="100%" id="menubarItemMirrorFlipWithinStrumline" text="Flip Within Strumline" tooltip="Mirror note selections within their strumlines or across both." selected="true" />
        </vbox>
    </menu>
    <menu-separator />
    <menu-item id="menubarItemSelectAllNotes" text="Select All Notes" shortcutText="Ctrl+A" />
    <menu-item id="menubarItemSelectAllEvents" text="Select All Events" shortcutText="Ctrl+Alt+A" />
    <menu-item id="menubarItemSelectInverse" text="Invert Selection" shortcutText="Ctrl+I" />
    <menu-item id="menubarItemSelectNone" text="Deselect All" shortcutText="Ctrl+D" />
    <menu-item id="menubarItemSelectRegion" text="Select Region" shortcutText="Tab" disabled="true" />
    <menu-item id="menubarItemSelectBeforePlayhead" text="Select Before Playhead" shortcutText="Shift+Home" />
    <menu-item id="menubarItemSelectAfterPlayhead" text="Select After Playhead" shortcutText="Shift+End" />
    <menu-separator />
    <menu text="Note Snapping">
      <menu-item id="menuBarItemNoteSnapDecrease" text="Decrease Note Snap Precision" shortcutText="Left Arrow" />
      <menu-item id="menuBarItemNoteSnapIncrease" text="Increase Note Snap Precision" shortcutText="Right Arrow" />
    </menu>
  </menu>
  <menu text="View">
    <menu-item id="menubarItemCommandPalette" text="Open Command Palette" shortcutText="Ctrl+P" />
    <menu-separator />
    <menu-checkbox width="100%" id="menubarItemDownscroll" text="Downscroll" disabled="true" />
    <menu-item id="menubarItemZoomIn" text="Zoom In" shortcutText="Ctrl+Scroll Up" />
    <menu-item id="menubarItemZoomOut" text="Zoom Out" shortcutText="Ctrl+Scroll Down" />
    <menu-item id="menubarItemZoomReset" text="Reset Zoom" />
    <menu-separator />
    <menu-checkbox width="100%" id="menubarItemViewWaveforms" text="Waveforms" />
    <menu-checkbox width="100%" id="menubarItemViewDifficultyHeatmap" text="Difficulty Heatmap" tooltip="Show what the calculator thinks is hard." />
    <menu-checkbox width="100%" id="menubarItemViewPlayerView" text="Player View" tooltip="Shade the part of the chart the player sees on screen at the playhead." />
    <menu-separator />
    <menu-item id="menubarItemDifficultyUp" text="Increase Difficulty" tooltip="Manage Difficulties with the Difficulty Toolbox" shortcutText="Ctrl+Left" />
    <menu-item id="menubarItemDifficultyDown" text="Decrease Difficulty" tooltip="Manage Difficulties with the Difficulty Toolbox" shortcutText="Ctrl+Right" />
  </menu>
  <menu text="Audio" width="260px;">
    <menu-item id="menubarItemPlayPause" text="Play/Pause" shortcutText="Space" />
    <menu-separator />
    <menu-checkbox width="100%" id="menubarItemMuteMetronome" text="Mute Metronome" shortcutText="Shift+M" tooltip="Silence the metronome without changing its volume." />
    <menu-checkbox width="100%" id="menubarItemMuteHitsounds" text="Mute Hitsounds" shortcutText="Shift+H" tooltip="Silence the hitsounds without changing their volumes." />
    <menu-checkbox width="100%" id="menubarItemMuteInstrumental" text="Mute Instrumental" shortcutText="Shift+I" tooltip="Silence the instrumental without changing its volume." />
    <menu-checkbox width="100%" id="menubarItemMuteOpponentVocals" text="Mute Opponent Vocals" shortcutText="Shift+D" tooltip="Silence the opponent's vocals without changing their volume. Shift+V toggles both vocals." />
    <menu-checkbox width="100%" id="menubarItemMutePlayerVocals" text="Mute Player Vocals" shortcutText="Shift+B" tooltip="Silence the player's vocals without changing their volume. Shift+V toggles both vocals." />
    <menu-separator />
    <menu-item id="menubarItemLoadInstrumental" text="Load Instrumental" />
    <menu-item id="menubarItemLoadVocals" text="Load Vocals" />
    <menu-separator />
    <vbox width="100%" style="padding: 5px; spacing: 2px;">
      <label id="menubarLabelPlaybackSpeed" styleName="menuLabel" text="Playback Speed - 100%" />
      <slider id="menubarItemPlaybackSpeed" styleName="compact" width="100%" majorTicks="10" minorTicks="5" pos="50" tooltip="Shift+Left/Right to change by 0.1x\nRight click to reset" />
    </vbox>
  </menu>
  <menu text="Test">
    <menu-item id="menubarItemPlaytestFull" text="Playtest Chart" shortcutText="Enter" />
    <menu-item id="menubarItemPlaytestMinimal" text="Playtest Chart (Minimal Mode)" shortcutText="Shift-Enter" />
  </menu>
  <menu text="Window">
    <vbox width="100%">
    <menu-checkbox width="100%" id="menubarItemToggleToolboxDifficulty" text="Difficulty" />
    <menu-checkbox width="100%" id="menubarItemToggleToolboxMetadata" text="Metadata" />
    <menu-checkbox width="100%" id="menubarItemToggleToolboxTiming" text="Timing" />
    <menu-checkbox width="100%" id="menubarItemToggleToolboxNoteData" text="Notes" />
    <menu-checkbox width="100%" id="menubarItemToggleToolboxEventData" text="Events" />
    <menu-checkbox width="100%" id="menubarItemToggleToolboxPlayerPreview" text="Player Preview" />
    <menu-checkbox width="100%" id="menubarItemToggleToolboxOpponentPreview" text="Opponent Preview" />
    </vbox>
  </menu>
  <menu text="Help">
    <menu-item id="menubarItemWelcomeDialog" text="Welcome Dialog" />
    <menu-item id="menubarItemUserGuide" text="User Guide" shortcutText="F1" />
    <menu-item id="menubarItemGoToBackupsFolder" text="Go to Backups Folder" />
    <menu-item id="menubarItemAbout" text="About..." />
  </menu>
  <spacer width="100%" />
  <menu-item id="menubarItemCameraEditor" text="Go to Camera Editor" />
</menubar>
