<?xml version="1.0" encoding="utf-8"?>
<vbox width="100%" height="100%" id="propertiesContainer">
  <LabeledRow text="Zoom">
    <number-stepper pos="1.0" step="0.05" width="160" min="0.1" max="5.0" id="zoomCameraZoomLevel" />
  </LabeledRow>
  <slider pos="1.0" minorTicks="0.2" majorTicks="1" precision="2" step="0.05" min="0.1" max="5.0" width="100%" id="zoomCameraZoomLevelSlider"/>
  <LabeledRow text="Mode">
    <dropdown text="Mode" width="160" id="zoomCameraMode">
      <data>
        <item value="0" text="Stage Zoom" />
        <item value="1" text="Absolute" />
      </data>
    </dropdown>
  </LabeledRow>
  <LabeledRow text="Duration">
    <number-stepper pos="1.25" step="0.1" min="0.1" width="160" id="zoomCameraDuration"/>
  </LabeledRow>
  <LabeledRow text="Widescreen Scale">
    <number-stepper pos="0.0" step="0.1" min="0.0" max="1.0" width="60" id="zoomCameraWidescreenScaleX"/>
    <number-stepper pos="0.0" step="0.1" min="0.0" max="1.0" width="60" id="zoomCameraWidescreenScaleY"/>
  </LabeledRow>
  <EasePropertyFrame id="zoomCameraEaseFrame" />
</vbox>
