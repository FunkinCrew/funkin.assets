<?xml version="1.0" encoding="utf-8"?>
<vbox width="100%" height="100%" id="propertiesContainer">
  <hbox width="100%">
    <label text="Target" verticalAlign="center" horizontalAlign="right" width="100%" />
    <dropdown text="Target" width="160" id="focusCameraTarget">
      <data>
        <item id="-1" text="Position" />
        <item id="0" text="Player" />
        <item id="1" text="Opponent" />
        <item id="2" text="Girlfriend" />
      </data>
    </dropdown>
  </hbox>
  <hbox width="100%">
    <label text="X Position" verticalAlign="center" horizontalAlign="right" width="100%" />
    <number-stepper pos="0.0" step="10.0" width="160" id="focusCameraXPos" />
  </hbox>
    <hbox width="100%">
    <label text="Y Position" verticalAlign="center" horizontalAlign="right" width="100%" />
    <number-stepper pos="0.0" step="10.0" width="160" id="focusCameraYPos" />
  </hbox>
  <hbox width="100%">
    <label text="Duration" verticalAlign="center" horizontalAlign="right" width="100%" />
    <number-stepper pos="1.25" step="0.1" min="0.1" width="160" id="focusCameraDuration" />
  </hbox>
  <frame text="Ease" collapsible="true" width="100%" height="180">
    <hbox width="100%" height="100%">
      <vbox width="100%" height="100%">
        <dropdown text="Ease" id="focusCameraEase" width="140">
          <data>
            <item id="linear" text="Linear" />
            <item id="INSTANT" text="Instant (Ignores duration)" />
            <item id="CLASSIC" text="Classic (Ignores duration)" />
            <item id="sine" text="Sine" />
            <item id="quad" text="Quad" />
            <item id="cube" text="Cube" />
            <item id="quart" text="Quart" />
            <item id="quint" text="Quint" />
            <item id="expo" text="Expo" />
            <item id="smoothStep" text="Smooth Step" />
            <item id="smootherStep" text="Smoother Step" />
            <item id="elastic" text="Elastic" />
            <item id="back" text="Back" />
            <item id="bounce" text="Bounce" />
            <item id="circ" text="Circ " />
          </data>
        </dropdown>
        <dropdown text="Ease Dir" id="focusCameraEaseDir" width="80" hidden="true">
          <data>
            <item id="In" text="In" />
            <item id="Out" text="Out" />
            <item id="InOut" text="In/Out" />
          </data>
        </dropdown>
      </vbox>
      <hbox width="100%" height="100%" id="focusCameraEaseBox">
        <image width="100" height="100" style="border:1px solid $normal-border-color" id="focusCameraEaseGraph" />
        <image width="16" height="100" style="border:1px solid $normal-border-color" id="focusCameraEaseDot" />
      </hbox>
    </hbox>
  </frame>
</vbox>
