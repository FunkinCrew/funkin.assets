<?xml version="1.0" encoding="utf-8"?>
<vbox width="100%" height="100%" id="propertiesContainer">
  <hbox width="100%">
    <label text="Target" verticalAlign="center" horizontalAlign="right" width="100%" />
    <dropdown text="Target" width="160" id="focusCameraTarget">
      <data>
        <item value="-1" text="Position" />
        <item value="0" text="Player" />
        <item value="1" text="Opponent" />
        <item value="2" text="Girlfriend" />
      </data>
    </dropdown>
  </hbox>
  <hbox width="100%">
    <label text="X Position" verticalAlign="center" horizontalAlign="right" width="100%" />
    <number-stepper pos="0.0" step="10.0" width="160" id="focusCameraXPos" />
  </hbox>
    <hbox width="100%">
    <label text="Y Position" verticalAlign="center" horizontalAlign="right" width="100%" />
    <number-stepper pos="0.0" step="10.0" width="160" id="focusCameraYPos" />
  </hbox>
  <hbox width="100%">
    <label text="Duration" verticalAlign="center" horizontalAlign="right" width="100%" />
    <number-stepper pos="1.25" step="0.1" min="0.1" max="10.0" width="160" id="focusCameraDuration" />
  </hbox>
  <frame text="Ease" collapsible="true" width="100%" height="180">
    <hbox width="100%" height="100%">
      <vbox width="50%" height="100%">
        <dropdown text="Ease Type" id="focusCameraEaseType">
          <data>
            <item value="elastic" text="Elastic" />
            <item value="cubic" text="Cubic" />
            <item value="linear" text="Linear" />
          </data>
        </dropdown>
        <dropdown text="Ease Dir" id="focusCameraEaseDir">
          <data>
            <item value="In" text="In" />
            <item value="In" text="Out" />
            <item value="In" text="In/Out" />
          </data>
        </dropdown>
      </vbox>
      <spacer width="100%" />
      <image width="160" height="160" style="border:1px solid $normal-border-color" />
    </hbox>
  </frame>
</vbox>
