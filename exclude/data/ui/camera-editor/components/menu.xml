<?xml version="1.0" encoding="utf-8"?>
<menubar id="menubar" width="100%" paddingLeft="256">
  <style>
    .menu {
    // The width of the individual menu items
    width: 160px;
    }
    #menubarOpenRecent {
      width: auto;
      initial-width: none;
      min-width: 160px;
      max-width: 800px;
    }
  </style>

  <menu text="File" id="menubarMenuFile">
    <menu-item id="menubarItemNewChart" text="New Chart" shortcutText="Ctrl+N" />
    <menu-separator />
    <menu-item id="menubarItemOpen" text="Open Chart" shortcutText="Ctrl+O" />
    <menu id="menubarOpenRecent" text="Open Recent" />
    <menu-separator />
    <menu-item id="menubarItemSave" text="Save Chart" shortcutText="Ctrl+S" />
    <menu-item id="menubarItemSaveAs" text="Save Chart As..." shortcutText="Ctrl+Shift+S" />
    <menu-separator />
    <menu id="menubarLoadVariation" text="Load Variation" />
    <menu-separator />
    <menu-item id="menubarItemPreferences" text="Preferences" disabled="true" />
    <menu-separator />
    <menu-item id="menubarItemExit" text="Exit" shortcutText="Ctrl+Q" />
  </menu>

  <menu text="Edit" width="208px;">
    <menu-item id="menubarItemUndo" text="Undo" shortcutText="Ctrl+Z" />
    <menu-item id="menubarItemRedo" text="Redo" shortcutText="Ctrl+Y" />
    <menu-separator />
  </menu>

  <menu text="View">
    <menu-checkbox width="100%" id="menubarItemFitCameraToViewport" text="Fit Camera to Viewport" />
    <menu-checkbox width="100%" id="menubarItemExtendedBounds" text="Show Extended Bounds" >
      <image resource="shared:assets/shared/images/ui/camera-editor/menu-bar/extended_vcam.png" width="16" height="16" />
    </menu-checkbox>
    <menu-checkbox width="100%" id="menubarItemDoBopping" text="Camera Bop" />
    <menu-checkbox width="100%" id="menubarItemDoSongEvents" text="Play Song Events" selected="true" />
    <menu-separator />
    <vbox width="100%">
      <menu-checkbox width="100%" id="menubarItemRelativeView" text="Relative View">
        <image resource="shared:assets/shared/images/ui/camera-editor/menu-bar/relative_view.png" width="16" height="16" />
      </menu-checkbox>
      <menu-checkbox width="100%" id="menubarItemPassepartout" text="Passepartout" >
        <image resource="shared:assets/shared/images/ui/camera-editor/menu-bar/passepartout.png" width="16" height="16" />
      </menu-checkbox>
      <slider id="menubarSliderPassepartoutTransparency" width="100%" pos="50" />
    </vbox>
    <menu-separator />
    <menu-item id="menubarItemResetCameraScroll" text="Reset Camera Scroll" shortcutText="Ctrl+R" />
    <menu-item id="menubarItemResetCameraZoom" text="Reset Camera Zoom" shortcutText="Ctrl+G" />
  </menu>

  <menu text="Playback">
    <menu-item id="menubarItemPlayPause" text="Toggle Playback" shortcutText="Space" />
    <menu-item id="menubarItemResetPlayback" text="Reset Playback" shortcutText="Home" />
  </menu>

  <menu text="Generate">
    <menu-item id="menubarItemAutoGen" text="Auto Generate Events" />
    <menu-item id="menubarItemAutoSortByType" text="Sort Events to Layers by Type" />
  </menu>

  <menu text="Help">
    <menu-item id="menubarItemUserGuide" text="User Guide" shortcutText="F1" />
    <menu-item id="menubarItemGoToBackupsFolder" text="Go to Backups Folder" />
    <menu-item id="menubarItemAbout" text="About..." />
  </menu>

  <spacer width="100%" />
  <menu-item id="menubarItemChartEditor" text="Go to Chart Editor" />
</menubar>
