<?xml version="1.0" encoding="utf-8"?>
<collapsible-dialog title="Object Properties" width="380" height="430">
  <vbox width="100%" height="100%">
    <frame text="Properties" width="100%" height="100%" horizontalAlign="center">
      <vbox width="100%" height="100%">
        <scrollview width="100%" height="100%" contentWidth="100%">
          <grid width="100%">
            <label text="Position" verticalAlign="center" />
            <hbox width="100%">
              <number-stepper id="inputObjectPositionX" step="5" pos="0" width="100%" />
              <number-stepper id="inputObjectPositionY" step="5" pos="0" width="100%" />
            </hbox>
            <label text="Scale" verticalAlign="center" />
            <hbox width="100%">
              <number-stepper id="inputObjectScaleX" step="0.05" pos="1" precision="2" min="0.05" width="100%" />
              <number-stepper id="inputObjectScaleY" step="0.05" pos="1" precision="2" min="0.05" width="100%" />
            </hbox>
            <label text="Z-Index" verticalAlign="center" />
            <number-stepper id="inputObjectZIndex" width="100%" />
            <label text="Scroll Factor" verticalAlign="center" />
            <hbox width="100%">
              <number-stepper id="inputObjectScrollX" step="0.05" pos="1" precision="2" width="100%" />
              <number-stepper id="inputObjectScrollY" step="0.05" pos="1" precision="2" width="100%" />
            </hbox>
            <label text="Opacity" verticalAlign="center" />
            <number-stepper id="inputObjectAlpha" pos="1" min="0" max="1" step="0.05" precision="2" width="100%" />
            <label text="Angle" verticalAlign="center" />
            <number-stepper id="inputObjectAngle" pos="0" min="0" max="360" width="100%" />
            <label text="Dance every" verticalAlign="center" />
            <number-stepper id="inputObjectDanceEvery" step="0.25" pos="0" min="0" width="100%" tooltip="The frequency at which the character will play its idle animation, in beats.\nIncreasing this number will make the character dance less often." />
            <label text="Blend Mode" verticalAlign="center" />
            <dropdown id="inputObjectBlend" text="Select Mode" width="120%" selectedIndex="0">
              <data>
                <item text="NONE" />
                <item text="ADD" />
                <item text="DARKEN" />
                <item text="DIFFERENCE" />
                <item text="HARDLIGHT" />
                <item text="INVERT" />
                <item text="LIGHTEN" />
                <item text="MULTIPLY" />
                <item text="OVERLAY" />
                <item text="SCREEN" />
                <item text="SUBTRACT" />
                <item text="COLORDODGE" />
                <item text="COLORBURN" />
                <item text="SOFTLIGHT" />
                <item text="EXCLUSION" />
                <item text="HUE" />
                <item text="SATURATION" />
                <item text="COLOR" />
                <item text="LUMINOSITY" />
              </data>
            </dropdown>
            <label text="Tint" verticalAlign="center" />
            <dropdown id="inputObjectTint" type="inputObjectTint" selectedItem="0xFFFFFFFF" width="100%" />
          </grid>
          <hbox width="100%" style="padding: 10px;">
            <spacer width="50%"/>
            <label text="Flip X" verticalAlign="center"/>
            <checkbox id="inputObjectFlipX"/>
            <spacer width="10%"/>
            <label text="Flip Y" verticalAlign="center"/>
            <checkbox id="inputObjectFlipY"/>
            <spacer width="10%"/>
            <label text="Antialiasing" verticalAlign="center"/>
            <checkbox id="inputObjectAntialiasing"/>
          </hbox>
        </scrollview>
      </vbox>
    </frame>
  </vbox>
</collapsible-dialog>
