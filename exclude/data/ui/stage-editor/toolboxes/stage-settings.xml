<?xml version="1.0" encoding="utf-8"?>
<collapsible-dialog title="Stage Properties" width="300" height="350">
  <vbox width="100%" height="100%">
    <section-header text="Stage ID"/>
    <textfield allowFocus="false" id="inputStageID" placeholder="Stage ID" width="100%" verticalAlign="center"/>

    <section-header text="Stage Name"/>
    <textfield id="inputStageName" placeholder="Stage Name" width="100%" verticalAlign="center"/>

    <section-header text="Camera Zoom"/>
    <number-stepper id="inputStageZoom" width="100%" min="0.15" max="10" step="0.05" precision="2"/>

    <section-header text="Asset Folder"/>
    <dropdown id="inputStageLibrary" width="100%" text="Search Library" searchable="true" searchPrompt="Search Library">
      <data /> <!--is filled with code-->
    </dropdown>

  </vbox>
</collapsible-dialog>
