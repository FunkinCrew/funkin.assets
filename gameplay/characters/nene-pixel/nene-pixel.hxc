import funkin.play.character.SparrowCharacter;
import funkin.play.PlayState;
import flixel.FlxSprite;
import flixel.group.FlxTypedSpriteGroup;
import funkin.graphics.FunkinSprite;
import funkin.audio.visualize.ABotVis;
import funkin.graphics.shaders.AdjustColorShader;
import funkin.graphics.shaders.DropShadowShader;

/**
 * The various states pixel Nene can be in.
 */
enum NenePixelState
{
  DEFAULT;
  PRE_RAISE;
  RAISE;
  READY;
  LOWER;
}

class NenePixelCharacter extends SparrowCharacter
{
  public function new()
  {
    super('nene-pixel');
  }

  function queryAssets(type:AssetType):Array<AssetPath>
  {
    var results = super.queryAssets(type);

    switch (type)
    {
      case "IMAGE":
        results.push(Paths.spritesheet("gameplay/characters/nene-pixel/abot-pixel/abot-pixel-head").image());
        results.push(Paths.spritesheet("gameplay/characters/nene-pixel/abot-pixel/abot-pixel-body").image());
        results.push(Paths.spritesheet("gameplay/characters/nene-pixel/abot-pixel/abot-pixel-back").image());
        results.push(Paths.spritesheet("gameplay/characters/nene-pixel/abot-pixel/abot-pixel-speaker").image());
        results.push(Paths.image("gameplay/characters/nene-pixel/nene-pixel-mask"));
        results.push(Paths.image("gameplay/characters/nene-pixel/abot-pixel/abot-pixel-speaker-mask"));
      case "XML":
        results.push(Paths.spritesheet("gameplay/characters/nene-pixel/abot-pixel/abot-pixel-head").xml());
        results.push(Paths.spritesheet("gameplay/characters/nene-pixel/abot-pixel/abot-pixel-body").xml());
        results.push(Paths.spritesheet("gameplay/characters/nene-pixel/abot-pixel/abot-pixel-back").xml());
        results.push(Paths.spritesheet("gameplay/characters/nene-pixel/abot-pixel/abot-pixel-speaker").xml());
    }

    return results;
  }

  var pupilState:Int = 0;
  var PUPIL_STATE_NORMAL = 0;
  var PUPIL_STATE_LEFT = 1;
  var abotSpeaker:FunkinSprite;
  var abot:FunkinSprite;
  var abotViz:ABotVis;
  var abotHead:FunkinSprite;
  var abotBack:FunkinSprite;

  override function onCreate(event:ScriptEvent)
  {
    super.onCreate(event);

    // Reposition sprites in onUpdate!

    abotHead = new FunkinSprite().loadSparrow('gameplay/characters/nene-pixel/abot-pixel/abot-pixel-head');
    abotHead.scale.set(6, 6);
    abotHead.antialiasing = false;
    abotHead.animation.addByPrefix('toleft', 'toleft0', 24, false);
    abotHead.animation.addByPrefix('toright', 'toright0', 24, false);

    abot = new FunkinSprite().loadSparrow('gameplay/characters/nene-pixel/abot-pixel/abot-pixel-body');
    abot.scale.set(6, 6);
    abot.origin.x = Math.round(abot.origin.x);
    abot.origin.y = Math.round(abot.origin.y);
    abot.antialiasing = false;
    abot.x = this.x;
    abot.y = this.y;
    abot.animation.addByPrefix('danceLeft', 'danceLeft', 24, false);
    abot.animation.addByPrefix('danceRight', 'danceRight', 24, false);
    abot.animation.addByPrefix('lowerKnife', 'return', 24, false);

    abotSpeaker = new FunkinSprite().loadSparrow('gameplay/characters/nene-pixel/abot-pixel/abot-pixel-speaker');
    abotSpeaker.scale.set(6, 6);
    abotSpeaker.origin.x = Math.round(abotSpeaker.origin.x);
    abotSpeaker.origin.y = Math.round(abotSpeaker.origin.y);
    abotSpeaker.antialiasing = false;
    abotSpeaker.x = this.x;
    abotSpeaker.y = this.y;
    // danceLeft and danceRight are identical for the speakers, we can just use 1 of em
    abotSpeaker.animation.addByPrefix('danceLeft', 'danceLeft', 24, false);

    abotBack = new FunkinSprite().loadTexture('gameplay/characters/nene-pixel/abot-pixel/abot-pixel-back');
    abotBack.scale.set(6.1, 6);
    abotBack.antialiasing = false;
    abotBack.x = this.x;
    abotBack.y = this.y;

    abotHead.animation.finishCallback = function(name:String):Void
    {
      if (name == 'toleft')
      {
        pupilState = PUPIL_STATE_LEFT;
      }

      if (name == 'toright')
      {
        pupilState = PUPIL_STATE_NORMAL;
      }
    }

    abotViz = new ABotVis(FlxG.sound.music, true);
    abotViz.x = this.x;
    abotViz.y = this.y;
    FlxG.debugger.track(abotSpeaker);
    // FlxG.debugger.track(abotSpeaker);

    abot.zIndex = this.zIndex - 10;
    abotViz.zIndex = abot.zIndex - 1;
    abotBack.zIndex = abot.zIndex - 2;
    abotSpeaker.zIndex = abot.zIndex - 3;
    abotHead.zIndex = abot.zIndex - 4;
  }

  /**
   * At this amount of life, Nene will raise her knife.
   */
  var VULTURE_THRESHOLD = 0.25 * 2;

  /**
   * Nene's animations are tracked in a simple state machine.
   * Given the current state and an incoming event, the state changes.
   */
  var currentState:NenePixelState = NenePixelState.DEFAULT;

  /**
   * Nene blinks every X beats, with X being randomly generated each time.
   * This keeps the animation from looking too periodic.
   */
  var MIN_BLINK_DELAY:Int = 3;

  var MAX_BLINK_DELAY:Int = 7;
  var blinkCountdown:Int = MIN_BLINK_DELAY;

  function addSunsetShaders()
  {
    var abotSpeakerShader = new DropShadowShader();
    abotSpeakerShader.setAdjustColor(-66, -10, 24, -23);
    abotSpeakerShader.angle = 90;
    abotSpeakerShader.color = 0xFF52351d;
    abotSpeakerShader.distance = 5;
    abotSpeakerShader.threshold = 1;

    abotSpeakerShader.attachedSprite = abotSpeaker;
    abotSpeaker.animation.onFrameChange.add(function()
    {
      abotSpeakerShader.updateFrameInfo(abotSpeaker.frame);
    });

    abotSpeakerShader.loadAltMask(Paths.image('gameplay/characters/nene-pixel/abot-pixel/abot-pixel-speaker-mask'));
    abotSpeakerShader.maskThreshold = 0;
    abotSpeakerShader.useAltMask = true;

    var noRimShader:AdjustColorShader = new AdjustColorShader();
    noRimShader.hue = -10;
    noRimShader.saturation = -23;
    noRimShader.brightness = -66;
    noRimShader.contrast = 24;

    abot.shader = noRimShader;
    abotBack.shader = noRimShader;
    abotHead.shader = noRimShader;
    abotViz.shader = noRimShader;
    abotSpeaker.shader = abotSpeakerShader;
  }

  override function dance(forceRestart:Bool)
  {
    if (abotSpeaker?.animation != null) abotSpeaker.animation.play("danceLeft", true);
    // Then, perform the appropriate animation for the current state.
    switch (currentState)
    {
      case NenePixelState.DEFAULT:
        if (hasDanced)
        {
          playAnimation('danceRight', true);
          if (abot?.animation != null) abot.animation.play("danceRight", true);
        }
        else
        {
          playAnimation('danceLeft', true);
          if (abot?.animation != null) abot.animation.play("danceLeft", true);
        }
        hasDanced = !hasDanced;
      case NenePixelState.PRE_RAISE:
        playAnimation('danceLeft', false);
        hasDanced = false;
      case NenePixelState.READY:
        if (blinkCountdown == 0)
        {
          // trace('NENE: Blinking...');
          playAnimation('idleKnifeBlink', false);
          blinkCountdown = FlxG.random.int(MIN_BLINK_DELAY, MAX_BLINK_DELAY);
        }
        else
        {
          blinkCountdown--;
          // trace('NENE: blink timer ' + blinkCountdown);
        }
      default:
        // In other states, don't interrupt the existing animation.
    }
  }

  /**
   * Called when the chart hits a song event.
   */
  override function onSongEvent(scriptEvent:SongEventScriptEvent)
  {
    super.onSongEvent(scriptEvent);
    if (scriptEvent.eventData.eventKind == "FocusCamera")
    {
      var eventProps = scriptEvent.eventData.value;
      switch (eventProps.char)
      {
        case 0:
          movePupilsRight();
        case 1:
          movePupilsLeft();
        default:
      }
    }
  }

  function movePupilsLeft():Void
  {
    if (pupilState == PUPIL_STATE_LEFT) return;
    // trace('Move pupils left');

    abotHead.animation.play('toleft');
  }

  function movePupilsRight():Void
  {
    if (pupilState == PUPIL_STATE_NORMAL) return;
    // trace('Move pupils right');

    abotHead.animation.play('toright');
  }

  override function onUpdate(event:UpdateScriptEvent)
  {
    super.onUpdate(event);

    // Set the visibility of ABot to match Nene's.
    abot.visible = this.visible;
    abotHead.visible = this.visible;
    abotViz.visible = this.visible;
    abotSpeaker.visible = this.visible;

    if (shouldTransitionState())
    {
      transitionState();
    }
  }

  override function onAdd(event:ScriptEvent):Void
  {
    super.onAdd(event);

    setupAbot();
  }

  function setupAbot():Void
  {
    abot.x = this.x + 296 - (-this.globalOffsets[0] * this.scale.x);
    abot.y = this.y + 430 - (-this.globalOffsets[1] * this.scale.y);
    abot.zIndex = this.zIndex - 10;

    currentStage.add(abot);

    abotBack.x = abot.x - 55;
    abotBack.y = abot.y + 0;
    abotBack.zIndex = abot.zIndex - 2;
    currentStage.add(abotBack);

    abotSpeaker.x = abot.x - 78;
    abotSpeaker.y = abot.y + 9;
    abotSpeaker.zIndex = abot.zIndex - 3;
    currentStage.add(abotSpeaker);

    abotHead.x = abot.x - 325;
    abotHead.y = abot.y + 72;
    abotHead.zIndex = abot.zIndex - 4;
    currentStage.add(abotHead);

    abotViz.x = abot.x - 162;
    abotViz.y = abot.y + 16;
    abotViz.zIndex = abot.zIndex - 1;
    currentStage.add(abotViz);

    currentStage.refresh();
  }

  override function onSongStart(event:ScriptEvent)
  {
    abotViz.snd = FlxG.sound.music;
    abotViz.initAnalyzer();
    abotViz.alpha = 1;
  }

  override function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry();
    abotViz.alpha = 0;
  }

  override function onSongEnd(event:ScriptEvent)
  {
    super.onSongEnd();
    abotViz.dumpSound();
  }

  var animationFinished:Bool = false;

  override function onAnimationFinished(name:String)
  {
    super.onAnimationFinished(name);

    switch (currentState)
    {
      case NenePixelState.RAISE, NenePixelState.LOWER, NenePixelState.READY:
        animationFinished = true;
        transitionState();
      default:
        // Ignore.
    }
  }

  override function onAnimationFrame(name:String, frameNumber:Int, frameIndex:Int)
  {
    super.onAnimationFrame(name, frameNumber, frameIndex);

    switch (currentState)
    {
      case NenePixelState.PRE_RAISE:
        if (name == "danceLeft" && frameNumber == 13)
        {
          animationFinished = true;
          transitionState();
        }
      default:
        // Ignore.
    }
  }

  function shouldTransitionState():Bool
  {
    return currentStage?.getBoyfriend()?.characterId != "pico-blazin";
  }

  function transitionState()
  {
    switch (currentState)
    {
      case NenePixelState.DEFAULT:
        if (PlayState.instance?.health <= VULTURE_THRESHOLD)
        {
          trace('NENE: Health is low, transitioning to NenePixelState.PRE_RAISE');
          currentState = NenePixelState.PRE_RAISE;
        }
        else
        {
          currentState = NenePixelState.DEFAULT;
        }
      case NenePixelState.PRE_RAISE:
        if (PlayState.instance?.health > VULTURE_THRESHOLD)
        {
          // trace('NENE: Health went back up, transitioning to NenePixelState.DEFAULT');
          currentState = NenePixelState.DEFAULT;
        }
        else if (animationFinished)
        {
          // trace('NENE: Animation finished, transitioning to NenePixelState.RAISE');
          currentState = NenePixelState.RAISE;
          playAnimation('raiseKnife');
          animationFinished = false;
        }
      case NenePixelState.RAISE:
        if (animationFinished)
        {
          // trace('NENE: Animation finished, transitioning to NenePixelState.READY');
          currentState = NenePixelState.READY;
          animationFinished = false;
        }
      case NenePixelState.READY:
        if (PlayState.instance?.health > VULTURE_THRESHOLD)
        {
          // trace('NENE: Health went back up, transitioning to NenePixelState.LOWER');
          currentState = NenePixelState.LOWER;
          playAnimation('lowerKnife');
        }
        else if (animationFinished)
        {
          // trace('NENE: Animation finished, transitioning to NenePixelState.READY');
          playAnimation('idleKnife');
          animationFinished = false;
        }
      case NenePixelState.LOWER:
        if (animationFinished)
        {
          // trace('NENE: Animation finished, transitioning to NenePixelState.DEFAULT');
          currentState = NenePixelState.DEFAULT;
          animationFinished = false;
        }
      default:
        // trace('UKNOWN STATE ' + currentState);
        currentState = NenePixelState.DEFAULT;
    }
  }
}
