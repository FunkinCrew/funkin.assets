import funkin.audio.FunkinSound;
import funkin.play.character.MultiAnimateAtlasCharacter;
import funkin.play.GameOverSubState;
import funkin.play.PlayState;
import funkin.util.HapticUtil;
//
// ~Imports for the new Paths system.~
// Temporary import aliases until we decide to remove backwards compatibility for mods.
//
import funkin.assets.Assets as NewAssets;
import funkin.assets.Paths as NewPaths;

class BoyfriendCharacter extends MultiAnimateAtlasCharacter
{
  public function new()
  {
    super('bf');
  }

  override public function queryAssets(type:AssetType):Array<AssetPath>
  {
    var results:Array<AssetPath> = super.queryAssets(type);

    switch (type)
    {
      case 'IMAGE':
        results.push(NewPaths.animateAtlas('gameplay/characters/bf/bf-fakeout').image());
      case 'JSON':
        results = results.concat(NewPaths.animateAtlas('gameplay/characters/bf/bf-fakeout').json());
      case 'SOUND':
        results.push(NewPaths.sound('gameplay/playable-characters/bf/game-over/loss-sfx-fakeout'));
    }

    return results;
  }

  override public function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    // Precache the sound for the fakeout death.
    NewAssets.cacheSound(NewPaths.sound('gameplay/playable-characters/bf/game-over/loss-sfx-fakeout'));
  }

  override function onAnimationFrame(name:String, frameNumber:Int, frameIndex:Int)
  {
    super.onAnimationFrame(name, frameNumber, frameIndex);

    if (!HapticUtil.hapticsAvailable) return;

    // BF's mic drops.
    if (name == 'firstDeath' && frameNumber == 27)
    {
      HapticUtil.vibrate(0, 0.1, 0.1, 1);
    }

    // BF's balls pulsating.
    if (name == 'deathLoop' && (frameNumber == 0 || frameNumber == 18))
    {
      HapticUtil.vibrate(0, 0.1, 0.1, 1);
    }
  }

  override public function playAnimation(name:String, restart:Bool = false, ignoreOther:Bool = false, reversed:Bool = false):Void
  {
    super.playAnimation(name, restart, ignoreOther, reversed);

    if (name == 'fakeoutDeath' && !this.debug)
    {
      doFakeoutDeath();
    }
  }

  function doFakeoutDeath():Void
  {
    FunkinSound.playOnce(NewPaths.sound('gameplay/playable-characters/bf/game-over/loss-sfx-fakeout').toFlxSoundAsset(), 1.0);

    // We don't want people to miss this.
    GameOverSubState.instance.mustNotExit = true;
    this.animation.onFinish.addOnce(() ->
    {
      GameOverSubState.instance.mustNotExit = false;
      this.playAnimation('firstDeath', true, true);
      // Play the 'blue balled' sound. May play a variant if one has been assigned.
      GameOverSubState.instance.playBlueBalledSFX();
    });
  }

  override public function getDeathQuote():Null<String>
  {
    switch (PlayState.instance?.currentStage?.getDad()?.characterId)
    {
      case 'tankman':
        var randomCensor:Array<Int> = [];

        if (!Preferences.naughtyness)
        {
          // 1 - cock
          // 3 - shitty
          // 8 - shit
          // 13 - fuck
          // 17 - shit, asshole
          // 21 - fucking
          randomCensor = [
            1,
            3,
            8,
            13,
            17,
            21
          ];
        }
        else if (Constants.CENSOR_EXPLETIVES)
        {
          randomCensor = [13, 21];
        }

        return NewPaths.sound('gameplay/characters/bf-holding-gf/sounds/jeff-gameover-' + FlxG.random.int(1, 25, randomCensor)).toFlxSoundAsset();
      default:
        return null;
    }
  }
}
