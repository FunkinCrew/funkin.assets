import funkin.audio.FunkinSound;
import funkin.play.character.AnimateAtlasCharacter;
import funkin.play.GameOverSubState;
import funkin.play.character.BaseCharacter;
import funkin.data.character.CharacterRegistry;
import funkin.play.character.CharacterType;
import funkin.play.PlayState;
import funkin.assets.Assets.AssetType;

class GirlfriendDarkCharacter extends AnimateAtlasCharacter
{
  public function new()
  {
    super('gf-dark');
  }

  public static function queryAssets(type:AssetType, charId:String):Array<AssetPath>
  {
    var results:Array<AssetPath> = AnimateAtlasCharacter.queryAssets(type, charId);
    results = results.concat(AnimateAtlasCharacter.queryAssets(type, 'gf'));

    return results;
  }

  var normalChar:BaseCharacter;

  override function set_alpha(val:Float):Float
  {
    super.set_alpha(val);

    if (normalChar != null)
    {
      if (val != 1) normalChar.alpha = 1;
      else
        normalChar.alpha = 0.0001;
    }

    return val;
  }

  override public function playAnimation(name:String, restart:Bool = false, ignoreOther:Bool = false, reversed:Bool = false)
  {
    super.playAnimation(name, restart, ignoreOther, reversed);
    if (normalChar != null)
    {
      normalChar.playAnimation(name, restart, ignoreOther);
      normalChar.setPosition(this.x - 45.5, this.y);
    }
  }

  override public function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    if (!this.debug)
    {
      normalChar = CharacterRegistry.instance.fetchEntry('gf');
      normalChar.zIndex = this.zIndex - 1;
      normalChar.alpha = 0.0001;
      normalChar.flipX = false;

      currentStage.add(normalChar);
      currentStage.refresh(); // Apply z-index.
    }
  }
}
