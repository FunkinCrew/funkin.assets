import funkin.play.character.BaseCharacter;
import funkin.data.character.CharacterRegistry;
import funkin.play.PlayState;
import funkin.play.character.MultiAnimateAtlasCharacter;
import funkin.util.HapticUtil;
import funkin.assets.Assets.AssetType;

class BoyfriendDarkCharacter extends MultiAnimateAtlasCharacter
{
  public function new()
  {
    super('bf-dark');
  }

  public static function queryAssets(type:AssetType, charId:String):Array<AssetPath>
  {
    var results = MultiAnimateAtlasCharacter.queryAssets(type, charId);
    results = results.concat(CharacterRegistry.instance.queryAssets(type, "bf"));
    return results;
  }

  override function onAnimationFrame(name:String, frameNumber:Int, frameIndex:Int)
  {
    super.onAnimationFrame(name, frameNumber, frameIndex);

    if (!HapticUtil.hapticsAvailable) return;

    // BF's mic drops.
    if (name == 'firstDeath' && frameNumber == 27)
    {
      HapticUtil.vibrate(0, 0.1, 0.1, 1);
    }

    // BF's balls pulsating.
    if (name == 'deathLoop' && (frameNumber == 0 || frameNumber == 18))
    {
      HapticUtil.vibrate(0, 0.1, 0.1, 1);
    }
  }

  var normalChar:BaseCharacter;

  override function set_alpha(val:Float):Float
  {
    super.set_alpha(val);

    if (normalChar != null)
    {
      if (val != 1) normalChar.alpha = 1;
      else
        normalChar.alpha = 0.0001;
    }

    return val;
  }

  override function playAnimation(name:String, restart:Bool = false, ignoreOther:Bool = false, reversed:Bool = false):Void
  {
    super.playAnimation(name, restart, ignoreOther, reversed);

    if (normalChar != null)
    {
      normalChar.playAnimation(name, restart, ignoreOther);
      normalChar.setPosition(this.x - 1, this.y - 11);
    }
  }

  override function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    if (!this.debug)
    {
      normalChar = CharacterRegistry.instance.fetchEntry('bf');
      normalChar.zIndex = 199;
      normalChar.alpha = 0.0001;
      normalChar.flipX = false;

      currentStage.add(normalChar);
      currentStage.refresh(); // Apply z-index.
    }
  }
}
