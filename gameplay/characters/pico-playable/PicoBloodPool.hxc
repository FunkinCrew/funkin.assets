import funkin.graphics.FunkinSprite;
import funkin.assets.Paths as NewPaths;

class PicoBloodPool extends FunkinSprite
{
  var extendBloodPool:Bool = false;

  public function new(x:Float, y:Float)
  {
    super(x, y);

    loadTextureAtlas('gameplay/stages/phillyTrainErect/blood-pool');
    this.animation.addBySymbol('wholeTimeline', this.getDefaultSymbol(), this.library.frameRate, false);

    animation.onFinish.addOnce((_) ->
    {
      extendBloodPool = true;
    });

    this.visible = false;
  }

  function doAnim():Void
  {
    animation.play('wholeTimeline', true);
    this.visible = true;
  }

  override function update(elapsed:Float)
  {
    super.update(elapsed);

    if (extendBloodPool)
    {
      var extendFactor:Float = 0.02 * elapsed;
      this.scale.set(this.scale.x + extendFactor, this.scale.y + extendFactor);
    }
  }
    
  public static function queryAssets(type:AssetType):Array<funkin.assets.Paths.AssetPath>
  {
    switch (type)
    {
      case 'IMAGE':
        return NewPaths.animateAtlas('gameplay/stages/phillyTrainErect/blood-pool').image();
      case 'JSON':
        return NewPaths.animateAtlas('gameplay/stages/phillyTrainErect/blood-pool').json();
      default:
        return [];
    }
  }
}
