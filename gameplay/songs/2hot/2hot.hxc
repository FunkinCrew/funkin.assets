import flixel.FlxSprite;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import funkin.util.HapticUtil;
import funkin.audio.FunkinSound;
import funkin.Conductor;
import funkin.graphics.FunkinSprite;
import funkin.play.cutscene.CutsceneType;
import funkin.play.cutscene.VideoCutscene;
import funkin.play.GameOverSubState;
import funkin.play.PlayState;
import funkin.play.PlayStatePlaylist;
import funkin.play.song.Song;
import funkin.play.stage.StageProp;
import funkin.save.Save;
import funkin.ui.FullScreenScaleMode;
import funkin.memory.FunkinMemory;
//
// ~Imports for the new Paths system.~
// Temporary import aliases until we decide to remove backwards compatibility for mods.
//
import funkin.assets.Assets as NewAssets;
import funkin.assets.Paths as NewPaths;

class TwoHOTSong extends Song
{
  var hasPlayedCutscene:Bool = false;
  var cutsceneConductor:Null<Conductor>;
  var canVibrationPreset:VibrationPreset = {
    period: 0.1,
    duration: 0.1,
    amplitude: 1,
    sharpness: 1
  };

  /**
   * Health lost when hit by can.
   */
  final HEALTH_LOSS:Float = 0.25 * 2;

  final STATE_ARCING:Int = 2; // In the air.
  final STATE_SHOT:Int = 3; // Hit by the player.
  final STATE_IMPACTED:Int = 4; // Impacted the player.

  override public function queryAssets(type:AssetType):Array<AssetPath>
  {
    var results:Array<AssetPath> = super.queryAssets(type);

    switch (type)
    {
      case 'SOUND':
        results.push(NewPaths.sound('gameplay/characters/pico-playable/sounds/bonk'));
        results.push(NewPaths.sound('gameplay/characters/pico-playable/sounds/gun-prep'));
        results.push(NewPaths.sound('gameplay/characters/pico-playable/sounds/shot-1'));
        results.push(NewPaths.sound('gameplay/characters/pico-playable/sounds/shot-2'));
        results.push(NewPaths.sound('gameplay/characters/pico-playable/sounds/shot-3'));
        results.push(NewPaths.sound('gameplay/characters/pico-playable/sounds/shot-4'));
        results.push(NewPaths.sound('gameplay/songs/2hot/sounds/darnell-lighter'));
        results.push(NewPaths.sound('gameplay/songs/2hot/sounds/kick-can-forward'));
        results.push(NewPaths.sound('gameplay/songs/2hot/sounds/kick-can-up'));
      case 'JSON':
        results.push(NewPaths.animateAtlas('gameplay/songs/2hot/spraycan').json());
      case 'IMAGE':
        results.push(NewPaths.animateAtlas('gameplay/songs/2hot/spraycan').image());
        results.push(NewPaths.spritesheet('gameplay/songs/2hot/graphics/spraycan-explosion-ez').image());
        results.push(NewPaths.spritesheet('gameplay/characters/pico-playable/pico-casing').image());
      case 'XML':
        results.push(NewPaths.spritesheet('gameplay/songs/2hot/graphics/spraycan-explosion-ez').xml());
        results.push(NewPaths.spritesheet('gameplay/characters/pico-playable/pico-casing').xml());
    }

    return results;
  }

  public function new()
  {
    super('2hot');

    hasPlayedCutscene = false;
  }

  override public function listDifficulties(variationId:String, variationIds:Array<String>, showLocked:Bool, showHidden:Bool):Array<String>
  {
    if (showLocked || Save.instance.hasBeatenLevel('weekend1'))
    {
      return super.listDifficulties(variationId, variationIds);
    }

    // Hide all difficulties if the player has not beaten the week.
    return [];
  }

  override public function onSongRetry(event:ScriptEvent):Void
  {
    super.onSongRetry(event);

    removeCans();
    gunCocked = false;
  }

  override public function onSongEnd(event:CountdownScriptEvent):Void
  {
    super.onSongEnd(event);

    if (!PlayStatePlaylist.isStoryMode) hasPlayedCutscene = true;

    if (!hasPlayedCutscene)
    {
      PlayState.instance.isInCutscene = true;
      PlayState.instance.mayPauseGame = false;
      hasPlayedCutscene = true;

      event.cancel();

      // start the video cutscene and hide it so the other stuff can happen after
      startCutscene();
    }
    else
    {
      // Make sure the cutscene can play again next time!
      hasPlayedCutscene = false;
      PlayState.instance.isInCutscene = false;
      PlayState.instance.mayPauseGame = true;
      // DO NOT CANCEL THE EVENT!
    }
  }

  function endCutscene():Void
  {
    VideoCutscene.onVideoStarted.removeAll();
    VideoCutscene.hideVideo();

    // This ensures Nene plays 'danceLeft' so that she syncs correctly with the cutscene video
    PlayState.instance.currentStage.getGirlfriend().hasDanced = false;
    PlayState.instance.currentStage.getGirlfriend().dance(true);

    new FlxTimer().start(1, function(tmr)
    {
      PlayState.instance.tweenCameraToPosition(1539, 833.5, 2, FlxEase.quadInOut);
      PlayState.instance.tweenCameraZoom(0.69, 2, true, FlxEase.quadInOut);
    });

    new FlxTimer().start(2, function(tmr)
    {
      PlayState.instance.currentStage.getBoyfriend().playAnimation('intro1', true, true);
      #if mobile
      FlxTween.tween(PlayState.instance.pauseButton, {
        x: (FlxG.width - PlayState.instance.pauseButton.width) - (40 + (FullScreenScaleMode.gameCutoutSize.x / 2))
      }, 3.0, {
        ease: FlxEase.quintOut
      });
      #end
      FullScreenScaleMode.addCutouts(3.0, FlxEase.quintOut);
    });

    new FlxTimer().start(2.5, function(tmr)
    {
      PlayState.instance.currentStage.getDad().playAnimation('pissed', true, true);
    });

    new FlxTimer().start(6, function(tmr)
    {
      trace('Pausing ending to play a video cutscene (`2hot`)');

      var bgSprite = new FunkinSprite(-100, -100);
      bgSprite.makeSolidColor(2000, 2500, 0xFF000000);
      bgSprite.cameras = [PlayState.instance.camHUD]; // Show over the HUD.
      bgSprite.zIndex = 1000000;
      PlayState.instance.add(bgSprite);
      PlayState.instance.refresh();

      VideoCutscene.showVideo();
    });
  }

  function startCutscene():Void
  {
    VideoCutscene.onVideoStarted.add(endCutscene);
    VideoCutscene.onVideoEnded.addOnce(function()
    {
      #if mobile
      PlayState.instance.pauseButton.x = (FlxG.width - PlayState.instance.pauseButton.width) - Math.max(40, FullScreenScaleMode.gameNotchSize.x);
      #end

      FullScreenScaleMode.removeCutouts();
    });

    cutsceneConductor = new Conductor();
    cutsceneConductor.forceBPM(86.5);
    cutsceneConductor.onBeatHit.add(() ->
    {
      if (PlayState.instance.currentStage.getGirlfriend().isAnimationFinished())
      {
        PlayState.instance.currentStage.getGirlfriend().dance(true);
      }
    });

    PlayState.instance.camHUD.visible = false;

    PlayState.instance.isInCutscene = true;
    hasPlayedCutscene = true;

    PlayState.instance.currentStage.getBoyfriend().danceEvery = 0;
    PlayState.instance.currentStage.getDad().danceEvery = 0;

    startVideo();
  }

  function startVideo():Void
  {
    VideoCutscene.play(NewPaths.video('gameplay/songs/2hot/cutscene'), CutsceneType.ENDING);
  }

  function removeCans():Void
  {
    for (can in spawnedCans)
    {
      can.kill();
    }
    spawnedCans = [];
  }

  override public function onStateChangeEnd(event:StateChangeScriptEvent):Void
  {
    super.onStateChangeEnd(event);

    if ((Std.isOfType(event.targetState, PlayState)))
    {
      return;
    }

    hardClear();
  }

  function hardClear():Void
  {
    removeCans();

    gunCocked = false;
  }

  var gunCocked:Bool = false;
  var spawnedCans:Array<SpraycanAtlasSprite> = [];

  override public function onNoteHit(event:HitNoteScriptEvent):Void
  {
    super.onNoteHit(event);

    if (PlayState.instance.currentStage == null) return;

    switch (event.note.kind)
    {
      case 'weekend-1-lightcan':
        // Do nothing, but place this such that the animation plays at the right time.
      case 'weekend-1-kickcan':
        // This creates the can and starts the animation.
        // We define the behavior of the can in a separate scripted class,
        // which allows the can to track and manage its own properties.
        var newCan:SpraycanAtlasSprite = new SpraycanAtlasSprite(0, 0);
        var spraycanPile:FunkinSprite = PlayState.instance.currentStage.getNamedProp('spraycanPile');

        newCan.x = spraycanPile.x - 10;
        newCan.y = spraycanPile.y - 550;
        newCan.zIndex = spraycanPile.zIndex - 1;

        newCan.playCanStart();

        PlayState.instance.currentStage.add(newCan);
        PlayState.instance.currentStage.refresh(); // Apply z-index.
        spawnedCans.push(newCan);
      case 'weekend-1-kneecan':
        // Do nothing, but place this such that the animation plays at the right time.
      case 'weekend-1-cockgun': // lol
        gunCocked = true;
        new FlxTimer().start(1.0, function()
        {
          gunCocked = false;
        });
      case 'weekend-1-firegun':
        if (gunCocked)
        {
          trace('Firing gun!');
          shootNextCan();
        }
        else
        {
          trace('Cannot fire gun!');
          // The player cannot hit this note.
          event.cancelEvent();
        }
    }
  }

  function getNextCanWithState(desiredState:Int):Void
  {
    for (index in 0...spawnedCans.length)
    {
      var can = spawnedCans[index];
      var canState = can.currentState;

      if (canState == desiredState)
      {
        // Return the can we found.
        return can;
      }
    }

    return null;
  }

  override public function onUpdate(event:UpdateScriptEvent):Void
  {
    cutsceneConductor?.update(cutsceneConductor.songPosition + event.elapsed * 1000);
  }

  function darkenStageProps():Void
  {
    // Darken the background, then fade it back.
    for (stageProp in PlayState.instance.currentStage.members)
    {
      // Determine if the stage prop is something that should be excluded from darkening.
      if (Std.isOfType(stageProp, StageProp))
      {
        if (stageProp.name == 'bf' || stageProp.name == 'dad' || stageProp.name == 'gf') // This refers to the player.
        {
          // Exclude.
          continue;
        }
      }

      // Select cans.
      if (spawnedCans.contains(stageProp))
      {
        // Exclude.
        continue;
      }

      // Hacky way of selecting PicoPlayable.picoFade.
      if (stageProp.zIndex == (PlayState.instance.currentStage.getBoyfriend().zIndex - 3))
      {
        // Exclude.
        continue;
      }

      // If not excluded, darken.
      stageProp.color = 0xFF111111;

      new FlxTimer().start(1 / 24, (tmr) ->
      {
        stageProp.color = 0xFF222222;
        FlxTween.color(stageProp, 1.4, 0xFF222222, 0xFFFFFFFF);
      });
    }
  }

  function blackenStageProps():Void
  {
    // Blacken the background (also Darnell and Nene) entirely, then restore it once the gameOverSubState is up.
    for (stageProp in PlayState.instance.currentStage.members)
    {
      // Determine if the stage prop is something that should be excluded from blackening.
      if (Std.isOfType(stageProp, StageProp))
      {
        if (stageProp.name == 'bf') // This refers to the player.
        {
          // Exclude.
          continue;
        }
      }

      // Select cans.
      if (spawnedCans.contains(stageProp))
      {
        // Exclude.
        continue;
      }

      // If not excluded, blacken.
      stageProp.color = 0xFF000000;

      new FlxTimer().start(1.0, (tmr) ->
      {
        stageProp.color = 0xFFFFFFFF;
      });
    }
  }

  function shootNextCan():Void
  {
    var can = getNextCanWithState(STATE_ARCING);

    if (can != null)
    {
      can.currentState = STATE_SHOT;
      can.playCanShot();

      new FlxTimer().start(1 / 24, function(tmr)
      {
        darkenStageProps();

        if (HapticUtil.hapticsAvailable)
        {
          HapticUtil.vibrateByPreset(canVibrationPreset);
        }
      });
    }
  }

  function missNextCan():Void
  {
    var can = getNextCanWithState(STATE_ARCING);

    if (can != null)
    {
      can.currentState = STATE_IMPACTED;
    }
  }

  function spawnImpactParticle():Void
  {
    var impactParticle:FunkinSprite = FunkinSprite.createSparrow(0, 0, 'gameplay/songs/2hot/graphics/can-impact');
    impactParticle.animation.addByPrefix('idle', 'CanImpactParticle0', 24, false);
    impactParticle.animation.play('idle');
    impactParticle.x = PlayState.instance.currentStage.getBoyfriend().x + 400;
    impactParticle.y = PlayState.instance.currentStage.getBoyfriend().y - 200;
    PlayState.instance.currentStage.add(impactParticle);

    impactParticle.animation.finishCallback = function()
    {
      impactParticle.kill();
    };
  }

  override public function onNoteMiss(event:NoteScriptEvent):Void
  {
    super.onNoteMiss(event);

    trace('Missed note on 2hot stage...' + event.note.noteData);

    switch (event.note.kind)
    {
      case 'weekend-1-cockgun':
        event.healthChange = 0.0; // We cause health loss later.
      case 'weekend-1-firegun':
        gunCocked = false;
        event.healthChange = 0.0; // We cause health loss elsewhere.
        missNextCan();
        takeCanDamage();
      case 'weekend-1-firegun-hip':
        gunCocked = false;
        event.healthChange = 0.0; // We cause health loss elsewhere.
        missNextCan();
        takeCanDamage();
      case 'weekend-1-firegun-far':
        gunCocked = false;
        event.healthChange = 0.0; // We cause health loss elsewhere.
        missNextCan();
        takeCanDamage();
    }
  }

  function takeCanDamage():Void
  {
    trace('Taking damage from can exploding!');

    PlayState.instance.health -= HEALTH_LOSS;

    if (PlayState.instance.health <= 0)
    {
      trace('Died to the can! Use special death animation.');

      // Reset to standard death animation.
      GameOverSubState.musicSuffix = '-pico-explode';
      GameOverSubState.blueBallSuffix = '-pico-explode';
      GameOverSubState.animationSuffix = '-explosion';

      if (!PlayState.instance.isPracticeMode && !PlayState.instance.isMinimalMode) blackenStageProps();
    }
    else if (HapticUtil.hapticsAvailable)
    {
      // Can hits pico.
      HapticUtil.vibrateByPreset(canVibrationPreset);

      new FlxTimer().start(0.45, function(tmr)
      {
        // Can explodes.
        HapticUtil.vibrateByPreset(canVibrationPreset);
      });
    }
  }

  /**
   * Replay the cutscene after leaving the song.
   */
  override public function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    hasPlayedCutscene = false;
    cutsceneConductor = null;

    // Precache the assets for the song.
    NewAssets.cacheFlxGraphic(NewPaths.image('gameplay/songs/2hot/graphics/can-impact'));
    NewAssets.cacheFlxGraphic(NewPaths.image('gameplay/songs/2hot/graphics/spraycan-explosion'));
    NewAssets.cacheFlxGraphic(NewPaths.image('gameplay/songs/2hot/graphics/spraycan-explosion-ez'));
    NewAssets.cacheFlxGraphic(NewPaths.image('gameplay/songs/2hot/spraycan/spritemap1'));
  }
}
