import funkin.play.song.Song;
import funkin.save.Save;
import funkin.graphics.FunkinSprite;
import flixel.util.FlxColor;
import funkin.play.PlayState;
import funkin.play.PlayStatePlaylist;
import funkin.audio.FunkinSound;
import funkin.data.song.SongRegistry;
import funkin.ui.transition.LoadingState;

class EggnogSong extends Song
{
  public function new()
  {
    super('eggnog');
    shouldEndSong = true;
  }

  var shouldEndSong:Bool = false;

  override function listAltInstrumentalIds(difficultyId:String, variationId:String):Array<String>
  {
    var results:Array<String> = super.listAltInstrumentalIds(difficultyId, variationId);

    if (difficultyId == 'easy' || difficultyId == 'normal' || difficultyId == 'hard')
    {
      var hasBeatenPicoMix = Save.instance.hasBeatenSong(this.id, null, 'pico');

      if (!hasBeatenPicoMix) results = [for (id in results) if (id != 'pico') id];
    }

    return results;
  }

  override function onSongEnd(event:ScriptEvent):Void
  {
    if (!PlayStatePlaylist.isStoryMode) return;

    if (shouldEndSong)
    {
      shouldEndSong = false;
      return;
    }

    event.cancel();

    if (!Assets.exists(Paths.sound('gameplay/stages/mallEvil/sounds/lights-off')))
    {
      shouldEndSong = true;
      PlayState.instance.endSong(true);
    }
    else
    {
      var blackBG:FunkinSprite = new FunkinSprite(-FlxG.width * FlxG.camera.zoom, -FlxG.height * FlxG.camera.zoom);
      blackBG.makeSolidColor(FlxG.width * 3, FlxG.height * 3, FlxColor.BLACK);
      blackBG.scrollFactor.set();

      PlayState.instance.currentStage.add(blackBG);
      PlayState.instance.isInCutscene = true;
      PlayState.instance.camHUD.visible = false;

      FunkinSound.playOnce(Paths.sound('gameplay/stages/mallEvil/sounds/lights-off'), 1.0, () ->
      {
        shouldEndSong = true;
        PlayState.instance.endSong(true);
      });
    }
  }
}
