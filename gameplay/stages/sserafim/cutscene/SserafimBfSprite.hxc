import funkin.graphics.FunkinSprite;

// object used when bf gets up during the second half of the intro animation for SPAGHETTI
class SserafimBfSprite extends FunkinSprite
{
  public function new(x:Float, y:Float)
  {
    super(x, y);

    loadTextureAtlas('gameplay/stages/sserafim/cutscene/bf-get-up');
    loadAnimations();
  }

  function loadAnimations():Void
  {
    animation.addByFrameLabel('static', 'static', 24, false);
    animation.addByFrameLabel('getup', 'getup', 24, false);
  }

  public function resetAnim():Void
  {
    this.animation.play('static', true);
  }

  public function doAnim():Void
  {
    this.animation.play('getup', true);
  }
}
