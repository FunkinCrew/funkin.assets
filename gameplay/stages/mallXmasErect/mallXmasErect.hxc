import flixel.FlxSprite;
import flixel.addons.display.FlxRuntimeShader;
import flixel.sound.FlxSound;
import funkin.Conductor;
import funkin.graphics.shaders.AdjustColorShader;
import funkin.play.PlayState;
import funkin.play.stage.Stage;
import funkin.play.character.CharacterType;
import funkin.assets.Assets.AssetType;
import funkin.assets.Paths as NewPaths;

class MallXmasErectStage extends Stage
{
  public function new()
  {
    super('mallXmasErect');
  }

  var colorShader:AdjustColorShader;

  public static function queryAssets(type:String, id:String, params:Dynamic):Array<AssetPath>
  {
    var results = Stage.queryAssets(type, id, params);

    switch (type)
    {
      case "SHADER":
        results.push(NewPaths.frag('ui/shaders/adjust-color'));
      default:
        // nothing
    }

    return results;
  }

  override function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    // Create a single color shader and reuse it.
    colorShader = new AdjustColorShader();
    colorShader.hue = 5;
    colorShader.saturation = 20;

    getNamedProp('santa').shader = colorShader;

    var colorShaderBoppers:AdjustColorShader = new AdjustColorShader();
    colorShaderBoppers.hue = 15;
    colorShaderBoppers.brightness = 20;
    var bottomBoppers:FunkinSprite = getNamedProp('bottomBoppers');

    bottomBoppers.shader = colorShaderBoppers;
    bottomBoppers.useRenderTexture = true;
  }

  override function addCharacter(character:BaseCharacter, charType:CharacterType):Void
  {
    // Apply the shader automatically to each character as it gets added.
    super.addCharacter(character, charType);

    trace('Applied stage shader to ' + character.characterName);
    character.shader = colorShader;

    // Enable render texture for Animate Atlas characters
    // This is so it doesn't run the shader on each individual limb!
    character.useRenderTexture = true;

    // TODO: GF Christmas flickers w/ RTT on Web, disable it for now until we have an ACTUAL fix!!
    #if web
    if (charType == CharacterType.GF)
    {
      character.useRenderTexture = false;
    }
    #end
  }
}
