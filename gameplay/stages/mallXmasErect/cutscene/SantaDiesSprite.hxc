import flixel.math.FlxPoint;
import flixel.FlxSprite;
import funkin.graphics.FunkinSprite;
import funkin.play.PlayState;
import funkin.assets.Assets.AssetType;
import funkin.assets.Paths as NewPaths;


// a unique object for santa getting KILLED
class SantaDiesSprite extends FunkinSprite
{
  public function new(x:Float, y:Float)
  {
    super(x, y);
    loadTextureAtlas('gameplay/stages/mallXmasErect/cutscene/santa-speaks');
    animation.addBySymbol('wholeTimeline', this.getDefaultSymbol(), this.library.frameRate, false);
  }

  function playCutscene():Void
  {
    // this.visible = true;
    this.animation.play('wholeTimeline');
  }

  public static function queryAssets(type:AssetType):Array<funkin.assets.Paths.AssetPath>
  {
    switch (type)
    {
      case 'IMAGE':
        return NewPaths.animateAtlas('gameplay/stages/mallXmasErect/cutscene/santa-speaks').image();
      case 'JSON':
        return NewPaths.animateAtlas('gameplay/stages/mallXmasErect/cutscene/santa-speaks').json();
      default:
        return [];
    }
  }
}
