import flixel.math.FlxPoint;
import flixel.FlxSprite;
import funkin.graphics.FunkinSprite;
import funkin.play.PlayState;

// a unique object for santa getting KILLED
class SantaDiesSprite extends FunkinSprite
{
  public function new(x:Float, y:Float)
  {
    super(x, y);
    loadTextureAtlas('gameplay/stages/mallXmasErect/cutscene/santa-speaks');
    animation.addBySymbol('wholeTimeline', this.getDefaultSymbol(), this.library.frameRate, false);
  }

  public function playCutscene():Void
  {
    // this.visible = true;
    this.animation.play('wholeTimeline');
  }
}
