import flixel.math.FlxPoint;
import flixel.FlxSprite;
import funkin.graphics.FunkinSprite;
import funkin.play.PlayState;

// a unique object for santa getting KILLED
class DadShootsSprite extends FunkinSprite
{
  public function new(x:Float, y:Float)
  {
    super(x, y);

    loadTextureAtlas("gameplay/stages/mallXmasErect/cutscene/parents-shoot");
  }

  public function playCutscene():Void
  {
    this.animation.play("parents whole scene");
  }
}
